<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign share_image = page_image
  if share_image == blank and settings.share_image != blank
    assign share_image = settings.share_image
  endif
  if share_image == blank and settings.logo != blank
    assign share_image = settings.logo
  endif
  if share_image == blank and product != blank and product.featured_image != blank
    assign share_image = product.featured_image
  endif

  assign meta_description = page_description | default: shop.description | default: shop.name
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = meta_description

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign robots_content = blank
  if request.page_type == 'cart' or request.page_type == 'password' or request.page_type == 'search'
    assign robots_content = 'noindex, follow'
  elsif request.page_type == 'customers/account' or request.page_type == 'customers/login' or request.page_type == 'customers/register' or request.page_type == 'customers/addresses' or request.page_type == 'customers/order' or request.page_type == 'customers/reset_password' or request.page_type == 'customers/activate_account'
    assign robots_content = 'noindex, nofollow'
  elsif current_page != 1
    assign robots_content = 'noindex, follow'
  endif
-%}

{% if settings.favicon != blank %}
  <link
    rel="icon"
    type="image/png"
    href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
  >
  <link
    rel="apple-touch-icon"
    href="{{ settings.favicon | image_url: width: 180, height: 180 }}"
  >
{% endif %}

<meta name="theme-color" content="{{ settings.background_color | default: '#071014' }}">

{%- if robots_content != blank -%}
  <meta name="robots" content="{{ robots_content }}">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if localization.available_languages.size > 1 -%}
  {%- for language in localization.available_languages -%}
    {%- if language.iso_code != request.locale.iso_code -%}
      <meta property="og:locale:alternate" content="{{ language.iso_code | replace: '-', '_' }}">
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%}
  Shopify Markets usually injects hreflang via content_for_header.
  Only emit a conservative x-default to the shop root when Markets is inactive.
{%- endcomment -%}
{%- if localization.available_languages.size <= 1 -%}
  <link rel="alternate" hreflang="x-default" href="{{ shop.url }}">
{%- endif -%}

{%- if share_image -%}
  {%- assign share_image_alt = share_image.alt | default: og_title | default: shop.name -%}
  {%- assign share_image_url = share_image | image_url: width: 1200 -%}
  <meta property="og:image" content="https:{{ share_image_url }}">
  <meta property="og:image:secure_url" content="https:{{ share_image_url }}">
  <meta property="og:image:width" content="{{ share_image.width | default: 1200 }}">
  <meta property="og:image:height" content="{{ share_image.height | default: 630 }}">
  <meta property="og:image:alt" content="{{ share_image_alt | escape }}">
  <meta name="twitter:image" content="https:{{ share_image_url }}">
  <meta name="twitter:image:alt" content="{{ share_image_alt | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>

  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {%- if article.updated_at != blank -%}
    <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {%- endif -%}
  {%- if article.author != blank -%}
    <meta property="article:author" content="{{ article.author | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'blog' and blog != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": {{ blog.title | json }},
      "url": {{ request.origin | append: blog.url | json }},
      "description": {{ blog.metafields.global.description | default: shop.description | json }},
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
      }
    }
  </script>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}
    {%- if settings.logo != blank -%}
    ,"logo": {
      "@type": "ImageObject",
      "url": "https:{{ settings.logo | image_url: width: 512 }}"
    }
    {%- endif -%}
    {%- if shop.email != blank -%}
    ,"email": {{ shop.email | json }}
    {%- endif -%}
    {%- if settings.seo_organization_description != blank -%}
    ,"description": {{ settings.seo_organization_description | json }}
    {%- elsif shop.description != blank -%}
    ,"description": {{ shop.description | strip_html | truncate: 300 | json }}
    {%- endif -%}
    {%- liquid
      assign same_as_count = 0
      if settings.social_instagram != blank
        assign same_as_count = same_as_count | plus: 1
      endif
      if settings.social_facebook != blank
        assign same_as_count = same_as_count | plus: 1
      endif
      if settings.social_tiktok != blank
        assign same_as_count = same_as_count | plus: 1
      endif
      if settings.social_youtube != blank
        assign same_as_count = same_as_count | plus: 1
      endif
      if settings.social_linkedin != blank
        assign same_as_count = same_as_count | plus: 1
      endif
    -%}
    {%- if same_as_count > 0 -%}
    ,"sameAs": [
      {%- assign same_as_emitted = false -%}
      {%- if settings.social_instagram != blank -%}
        {{ settings.social_instagram | json }}{%- assign same_as_emitted = true -%}
      {%- endif -%}
      {%- if settings.social_facebook != blank -%}
        {%- if same_as_emitted -%},{%- endif -%}{{ settings.social_facebook | json }}{%- assign same_as_emitted = true -%}
      {%- endif -%}
      {%- if settings.social_tiktok != blank -%}
        {%- if same_as_emitted -%},{%- endif -%}{{ settings.social_tiktok | json }}{%- assign same_as_emitted = true -%}
      {%- endif -%}
      {%- if settings.social_youtube != blank -%}
        {%- if same_as_emitted -%},{%- endif -%}{{ settings.social_youtube | json }}{%- assign same_as_emitted = true -%}
      {%- endif -%}
      {%- if settings.social_linkedin != blank -%}
        {%- if same_as_emitted -%},{%- endif -%}{{ settings.social_linkedin | json }}
      {%- endif -%}
    ]
    {%- endif -%}
  }
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {%- capture search_url_template -%}{{ shop.url }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ search_url_template | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if settings.social_twitter != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter | replace: 'https://twitter.com/', '@' | replace: 'https://x.com/', '@' | escape }}">
{%- endif -%}

<title>
  {{ page_title }}
  {%- if current_tags -%}
    {%- assign seo_tags = current_tags | join: ', ' -%}
    &ndash; {{ 'seo.tagged' | t: tags: seo_tags }}
  {%- endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'seo.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

<meta name="description" content="{{ meta_description | escape }}">
