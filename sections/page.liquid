{% comment %}
  Content page template section.
{% endcomment %}

<article
  class="legal-page full-width pp-accent-line"
  style="
    --legal-bg: {{ section.settings.background_color }};
    --legal-surface: {{ section.settings.surface_color }};
    --legal-text: {{ section.settings.text_color }};
    --legal-muted: {{ section.settings.muted_text_color }};
    --legal-accent: {{ section.settings.accent_color }};
  "
>
  <div class="legal-page__inner">
    {% render 'breadcrumbs' %}
    <header class="legal-page__header">
      {% if section.settings.eyebrow != blank %}
        <p class="legal-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="legal-page__title">{{ page.title }}</h1>
    </header>

    <div class="legal-page__panel">
      <div class="legal-page__content pp-legal-prose rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Information"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#071014"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Surface",
      "default": "#14212A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F6F7F2"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#9AA8A2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#2DD4BF"
    }
  ]
}
{% endschema %}
